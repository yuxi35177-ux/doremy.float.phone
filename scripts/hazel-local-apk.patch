+#!/usr/bin/env bash
+set -euo pipefail
+export PHONE_LOCAL_BUILD=1 NEXT_PUBLIC_PHONE_LOCAL=1 NEXT_PUBLIC_SELF_HOSTED_MODE=1 NEXT_TELEMETRY_DISABLED=1
+npm ci --no-audit --no-fund
+npm run build
+node scripts/package-phone-server.mjs
+mkdir -p android-shell/app/libnode
+curl -fL --retry 2 https://github.com/nodejs-mobile/nodejs-mobile/releases/download/v18.20.4/nodejs-mobile-v18.20.4-android.zip -o "$RUNNER_TEMP/nodejs-mobile.zip"
+unzip -q "$RUNNER_TEMP/nodejs-mobile.zip" -d android-shell/app/libnode
+# Shipping only arm64 matches the vivo S17; don't package unused device runtimes.
+test -f android-shell/app/libnode/bin/arm64-v8a/libnode.so
+test -f android-shell/app/libnode/include/node/node.h
diff --git a/scripts/package-phone-server.mjs b/scripts/package-phone-server.mjs
new file mode 100644
index 0000000..b118af8
--- /dev/null
+++ b/scripts/package-phone-server.mjs
@@ -0,0 +1,19 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+const root = process.cwd();
+const output = path.join(root, '.phone-server');
+fs.rmSync(output, {recursive:true, force:true});
+fs.cpSync('.next/standalone', output, {recursive:true, dereference:true, filter: p =>
+  !/[/\\](?:\.env(?:\.[^/\\]+)?|\.git|android-shell)(?:[/\\]|$)/.test(p)});
+fs.cpSync('.next/static', path.join(output,'.next/static'), {recursive:true});
+fs.cpSync('public', path.join(output,'public'), {recursive:true});
+fs.copyFileSync('scripts/phone-bootstrap.cjs', path.join(output,'phone-bootstrap.cjs'));
+// Fail rather than silently ship an online shell or omit a settings screen.
+for (const p of ['server.js','.next/server/app/index.html','public/icon-192.png']) {
+  if (!fs.existsSync(path.join(output,p))) throw new Error(`Missing local bundle file: ${p}`);
+}
+const assets = 'android-shell/app/src/main/assets';
+fs.mkdirSync(assets,{recursive:true});
+execFileSync('zip',['-qr',path.join(root,assets,'phone-server.zip'),'.'],{cwd:output});
+console.log(`Bundled local server: ${fs.statSync(path.join(assets,'phone-server.zip')).size} bytes`);
diff --git a/scripts/phone-bootstrap.cjs b/scripts/phone-bootstrap.cjs
new file mode 100644
index 0000000..26a5ad1
--- /dev/null
+++ b/scripts/phone-bootstrap.cjs
@@ -0,0 +1,24 @@
+// All code and API handlers run on the device. No original-site fallback.
+const { File } = require('node:buffer');
+const { toUSVString } = require('node:util');
+globalThis.File ||= File;
+String.prototype.toWellFormed ||= function () { return toUSVString(this); };
+String.prototype.isWellFormed ||= function () { return toUSVString(this) === String(this); };
+process.env.NEXT_PUBLIC_SELF_HOSTED_MODE = '1';
+process.env.NEXT_TELEMETRY_DISABLED = '1';
+const http = require('node:http');
+const originalEmit = http.Server.prototype.emit;
+http.Server.prototype.emit = function (event, ...args) {
+  if (event === 'request') {
+    const [req, res] = args;
+    if (req.headers['x-phone-local-token'] !== process.env.PHONE_LOCAL_TOKEN) {
+      res.writeHead(403); res.end('Forbidden'); return true;
+    }
+    if (req.url === '/phone-local-health') {
+      res.writeHead(200, {'content-type':'application/json'});
+      res.end(JSON.stringify({local:true})); return true;
+    }
+  }
+  return originalEmit.call(this, event, ...args);
+};
+require('./server.js');
